<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#14161B" BorderBrush="#262A33" BorderThickness="1"
        TextElement.Foreground="#E8EAEE" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border.Effect>
    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
  </Border.Effect>
  <Border.Resources><!--THEME--></Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Border Width="20" Height="20" CornerRadius="6" Background="#2FB36E" Margin="0,0,10,0">
          <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Win Cleaner" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="  by mysik" Foreground="#6E7584" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="16,2,16,0" Background="#1C1F26" CornerRadius="12" Padding="4">
      <UniformGrid Columns="3">
        <RadioButton x:Name="NavClean" Style="{StaticResource NavBtn}" IsChecked="True" Content="Очистка"/>
        <RadioButton x:Name="NavTweaks" Style="{StaticResource NavBtn}" Content="Windows"/>
        <RadioButton x:Name="NavStartup" Style="{StaticResource NavBtn}" Content="Автозагрузка"/>
      </UniformGrid>
    </Border>



    <!-- ===== ОЧИСТКА ===== -->
    <Grid x:Name="PageClean" Grid.Row="2" Margin="16,14,16,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Background="#1C1F26" CornerRadius="14" Padding="18,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="CleanCaption" Text="Можно освободить" Foreground="#8B92A0" FontSize="12"/>
            <TextBlock x:Name="CleanTotal" Text="…" FontSize="30" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock x:Name="CleanSub" Text="Ищу ненужные файлы" Foreground="#8B92A0" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
          <Button x:Name="ScanBtn" Grid.Column="1" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Проверить заново"
                  VerticalAlignment="Top"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,-6,0">
        <Border Background="#1C1F26" CornerRadius="14" Padding="14,6" Margin="0,0,6,0" VerticalAlignment="Top">
          <StackPanel x:Name="CleanList"/>
        </Border>
      </ScrollViewer>

      <Button x:Name="CleanBtn" Grid.Row="2" Style="{StaticResource PrimaryBtn}" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <TextBlock x:Name="CleanBtnText" Text="Очистить" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- ===== WINDOWS ===== -->
    <Grid x:Name="PageTweaks" Grid.Row="2" Margin="16,14,16,16" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Margin="4,0,0,10">
        <TextBlock Text="Настройки Windows" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Каждый переключатель можно вернуть обратно. Изменения применяются сразу." Style="{StaticResource Hint}"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
        <StackPanel Margin="0,0,6,0">
          <Border Background="#1C1F26" CornerRadius="14" Padding="16,4">
            <StackPanel x:Name="TweakList"/>
          </Border>
          <TextBlock Style="{StaticResource Hint}" Margin="4,14,4,4">
            <Run Text="Win Cleaner"/>
            <Run x:Name="Signature" Text="by mysik" Foreground="#2FB36E" FontWeight="SemiBold" Cursor="Hand"/>
          </TextBlock>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="RestoreBtn" Style="{StaticResource SecondaryBtn}" Background="#1C1F26" Padding="10,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Точка восстановления" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ExplorerBtn" Grid.Column="2" Style="{StaticResource SecondaryBtn}" Background="#1C1F26" Padding="10,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Перезапустить проводник" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Grid>

    <!-- ===== АВТОЗАГРУЗКА ===== -->
    <Grid x:Name="PageStartup" Grid.Row="2" Margin="16,14,16,16" Visibility="Collapsed">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Margin="4,0,0,10">
        <StackPanel Margin="0,0,50,0">
          <TextBlock Text="Автозагрузка" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="StartupSummary" Text="Программы, которые запускаются вместе с Windows" Style="{StaticResource Hint}"/>
        </StackPanel>
        <Button x:Name="StartupRefreshBtn" Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Обновить"
                HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-6,0">
        <StackPanel Margin="0,0,6,0">
          <Border Background="#1C1F26" CornerRadius="14" Padding="14,4">
            <StackPanel x:Name="StartupList"/>
          </Border>
          <TextBlock Text="Отключённая программа просто не запускается при входе в Windows: она остаётся на компьютере, и её можно включить обратно. Так же работает Диспетчер задач."
                     Style="{StaticResource Hint}" Margin="4,12,4,4"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border x:Name="Snack" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,22" Padding="16,11" CornerRadius="12" Background="#2A2E38" BorderBrush="#363B47" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
      </Border.Effect>
      <TextBlock x:Name="SnackText" Text="" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#B30B0C10" Visibility="Collapsed">
      <Border Width="330" Background="#1E2128" CornerRadius="16" Padding="20" BorderBrush="#2E333E" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DlgNo" Style="{StaticResource SecondaryBtn}" Background="#2A2E38" Content="Отмена"/>
            <Button x:Name="DlgYes" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="OK"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Border>
